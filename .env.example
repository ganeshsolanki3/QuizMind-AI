# Copy this file to .env and fill in your own values.
FLASK_SECRET_KEY=replace-with-a-long-random-secret
FLASK_DEBUG=false
DATABASE_URL=sqlite:///quizmind.db

# Get your Gemini API key from Google AI Studio.
GEMINI_API_KEY=your_gemini_api_key_here
# Use a model available to your Google AI Studio account. Change it here only.
GEMINI_MODEL=gemini-2.5-flash

# Gmail: use your Gmail address and a Google App Password, not your normal password.
MAIL_SENDER=you@gmail.com
MAIL_PASSWORD=your_16_character_google_app_password
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587


